{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/liangboqiang/TjuaeCore/main/schemas/local-assistant-definition.v1.schema.json",
  "title": "Tjuae Core 本地助手 Definition v1",
  "description": "本地可编辑助手内容。引擎、模型、权限、启用状态和排序属于设备 Overlay，不得写入本文件。",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "runtimeId",
    "name",
    "rules",
    "skillDependencies",
    "avatar"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/liangboqiang/TjuaeCore/main/schemas/local-assistant-definition.v1.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "assistant" },
    "runtimeId": { "$ref": "#/$defs/RuntimeId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "nameI18n": { "$ref": "#/$defs/LocalizedString" },
    "description": { "type": ["string", "null"], "maxLength": 4096 },
    "descriptionI18n": { "$ref": "#/$defs/LocalizedString" },
    "rules": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/Locale" },
      "additionalProperties": { "$ref": "#/$defs/SafeRelativePath" }
    },
    "recommendedPrompts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
    },
    "recommendedPromptsI18n": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/Locale" },
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
      }
    },
    "skillDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["source", "assetId"],
        "additionalProperties": false,
        "properties": {
          "source": { "const": "local" },
          "assetId": { "$ref": "#/$defs/LocalAssetId" }
        }
      }
    },
    "avatar": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": { "type": { "const": "none" } }
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "emoji" },
            "value": { "type": "string", "minLength": 1, "maxLength": 32 }
          }
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "file" },
            "path": { "$ref": "#/$defs/SafeRelativePath" }
          }
        }
      ]
    }
  },
  "$defs": {
    "RuntimeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "LocalAssetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\\\/\\u0000]+$"
    },
    "Locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$",
      "minLength": 2,
      "maxLength": 16
    },
    "LocalizedString": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/Locale" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "SafeRelativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    }
  }
}
